          "purpose": "verify_email",
          "code": "042917",
          "user_id": "00000000-0000-4000-8000-000000000021",
          "expires_in_seconds": 300,
          "idempotency_key": "otp-3f6c2b1e-8a4d-4c55-9e1f-2a7b9c0d1e2f"
