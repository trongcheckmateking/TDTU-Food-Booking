    "/internal/notifications/email": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Auth gửi email mã OTP qua nhà cung cấp (idempotent theo idempotency_key)",
        "description": "Ghi email_logs (sending), gọi `POST {EMAIL_PROVIDER_URL}/api/send` với X-API-Key, Idempotency-Key, X-Request-ID (timeout EMAIL_PROVIDER_TIMEOUT), provider nhận -> sent. Gửi lại cùng khóa khi đã sent/delivered -> 200 replay (không gọi provider). Bản ghi failed hoặc sending quá 30 giây được gửi lại trên chính dòng đó (cùng id).",
        "operationId": "send_email_internal_notifications_email_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailSend"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Provider đã nhận email (status sent)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailSent"
                }
              }
            }
          },
          "200": {
            "description": "Cùng idempotency_key đã gửi: trả lại kết quả cũ, replay=true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailSent"
                }
              }
            }
          },
          "400": {
            "description": "EMAIL_REJECTED: provider trả 4xx khác",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_ONLY: thiếu hoặc sai X-Internal-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_IN_PROGRESS: cùng khóa đang gửi (dưới 30 giây) hoặc provider trả 409",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "EMAIL_PROVIDER_AUTH (provider 401/403), EMAIL_PROVIDER_ERROR (5xx), EMAIL_PROVIDER_BAD_RESPONSE (2xx sai dạng)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "EMAIL_NOT_CONFIGURED, EMAIL_PROVIDER_UNAVAILABLE (lỗi mạng / quá thời gian chờ), EMAIL_PROVIDER_RATE_LIMITED (provider 429; header Retry-After lấy từ provider, mặc định 60)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/webhooks/email-status": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Webhook của nhà cung cấp email: kết quả giao thư (ký HMAC, không dùng X-Internal-Key)",
        "description": "Header `X-Webhook-Signature: sha256=<hex HMAC-SHA256(EMAIL_WEBHOOK_SECRET, BODY THÔ)>`, so sánh thời gian không đổi. Chỉ cho sent -> delivered / failed; cùng trạng thái -> 200; bản ghi đã ở trạng thái cuối khác -> 200 {received, ignored}.",
        "operationId": "email_webhook_internal_webhooks_email_status_post",
        "security": [],
        "parameters": [
          {
            "name": "X-Webhook-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailWebhook"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã nhận: {received: true, message_id, status} hoặc {received: true, ignored: true}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": {
                      "type": "boolean"
                    },
                    "message_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "ignored": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "received"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_SIGNATURE: sai chữ ký hoặc server chưa cấu hình EMAIL_WEBHOOK_SECRET",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "EMAIL_NOT_FOUND: không có email với message_id này (provider sẽ thử lại)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR (trường lạ, status ngoài delivered/failed...)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
