          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "order_id",
          "type",
          "message",
          "status",
          "created_at"
        ],
        "title": "NotificationOut"
      },
      "NotificationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "unread": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unread"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "NotificationPage"
      },
      "OrderEvent": {
        "properties": {
          "event_key": {
            "type": "string",
            "maxLength": 120,
            "minLength": 10,
            "title": "Event Key"
          },
          "event": {
            "type": "string",
            "enum": [
              "order_created",
              "order_confirmed",
              "order_completed",
              "order_cancelled",
              "payment_claimed",
              "payment_confirmed",
              "payment_refunded"
            ],
            "title": "Event",
            "description": "payment_claimed: sinh viên báo đã chuyển khoản (đơn mới, báo chủ quán); payment_confirmed: quán nhận được tiền (báo sinh viên); payment_refunded: quán đã hoàn tiền đơn bị hủy (báo sinh viên). order_created chỉ còn ở đơn trước khi có thanh toán trước."
          },
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id"
          },
          "order_code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Order Code"
          },
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "owner_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Id"
          },
          "restaurant_name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Restaurant Name"
          },
          "actor_role": {
            "type": "string",
            "enum": [
              "sinh_vien",
