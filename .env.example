# Cấu hình TDTU Food Booking (dùng chung cho 5 service: Python, Node.js, Java, Go, PHP).
# Sao chép thành .env hoặc chạy: python manage.py init-env   (tự sinh các khóa ngẫu nhiên)
# KHÔNG đưa tệp .env thật lên Git / vào bài nộp.

# Khóa ký JWT của Auth Service (>= 32 ký tự). init-env tự sinh ngẫu nhiên.
JWT_SECRET=
# Khóa cho API nội bộ giữa các service (>= 24 ký tự). init-env tự sinh ngẫu nhiên.
INTERNAL_KEY=
# Thời hạn token đăng nhập (giờ)
TOKEN_HOURS=8

# Thư mục dữ liệu (tương đối so với thư mục dự án):
#   auth.db, restaurant.db, review.db (SQLite) và order.mv.db (H2 của Spring Boot)
DATA_DIR=data

# PostgreSQL cho Notification Service (Go). init-env tự sinh mật khẩu; tạo user/database bằng
#   python manage.py pg-setup        (cần psql + tài khoản postgres)
# hoặc docker compose -f services/notification/docker-compose.postgres.yml --env-file .env up -d
POSTGRES_PASSWORD=
NOTIFICATION_DB_URL=postgres://tdtu_food:<POSTGRES_PASSWORD>@127.0.0.1:5432/tdtu_notification?sslmode=disable

# Địa chỉ các service (cổng lấy từ URL)
AUTH_URL=http://127.0.0.1:8001
RESTAURANT_URL=http://127.0.0.1:8002
ORDER_URL=http://127.0.0.1:8003
NOTIFICATION_URL=http://127.0.0.1:8004
REVIEW_URL=http://127.0.0.1:8005
WEB_PORT=8000

# Nguồn web được phép gọi API (CORS), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Thời gian chờ khi service gọi nhau (giây)
HTTP_TIMEOUT=5
# Chu kỳ worker của Order gửi lại thông báo lỗi (giây, 0 = tắt)
OUTBOX_INTERVAL=15
# INFO hoặc WARNING (WARNING: bớt log truy cập)
LOG_LEVEL=INFO
