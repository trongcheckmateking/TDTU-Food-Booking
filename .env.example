# Cấu hình TDTU Food Booking (dùng chung cho 5 service: Python, Node.js, Java, Go, PHP).
# Sao chép thành .env hoặc chạy: python manage.py init-env   (tự sinh các khóa ngẫu nhiên)
# KHÔNG đưa tệp .env thật lên Git / vào bài nộp.

# Khóa ký JWT của Auth Service (>= 32 ký tự). init-env tự sinh ngẫu nhiên.
JWT_SECRET=
# Khóa cho API nội bộ giữa các service (>= 24 ký tự). init-env tự sinh ngẫu nhiên.
INTERNAL_KEY=
# Thời hạn token đăng nhập (giờ)
TOKEN_HOURS=8
# Chống dò mật khẩu: sai LOGIN_MAX_FAILS lần trong LOGIN_WINDOW_SECONDS giây (cùng email + IP)
# thì tạm khóa đăng nhập LOGIN_LOCK_SECONDS giây
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Thư mục dữ liệu (tương đối so với thư mục dự án):
#   auth.db, restaurant.db, review.db (SQLite) và order.mv.db (H2 của Spring Boot)
DATA_DIR=data

# PostgreSQL cho Notification Service (Go). init-env tự sinh mật khẩu; tạo user/database bằng
#   python manage.py pg-setup        (cần psql + tài khoản postgres)
# hoặc docker compose -f services/notification/docker-compose.postgres.yml --env-file .env up -d
POSTGRES_PASSWORD=
NOTIFICATION_DB_URL=postgres://tdtu_food:<POSTGRES_PASSWORD>@127.0.0.1:5432/tdtu_notification?sslmode=disable

# Địa chỉ các service (cổng lấy từ URL)
AUTH_URL=http://127.0.0.1:8001
RESTAURANT_URL=http://127.0.0.1:8002
ORDER_URL=http://127.0.0.1:8003
NOTIFICATION_URL=http://127.0.0.1:8004
REVIEW_URL=http://127.0.0.1:8005
WEB_PORT=8000

# Nguồn web được phép gọi API (CORS), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Mã QR và dùng trên điện thoại (cùng mạng Wi-Fi/LAN). Để trống khi chỉ chạy trên một máy.
# Đặt bằng địa chỉ IP LAN của máy chạy app, rồi: python manage.py start --host 0.0.0.0
#   PUBLIC_WEB_URL: địa chỉ mã QR trỏ tới (trang giao diện :8000)
#   PUBLIC_<SERVICE>_URL: địa chỉ trình duyệt điện thoại gọi tới từng service
#   và thêm http://<IP>:8000 vào CORS_ORIGINS ở trên.
PUBLIC_WEB_URL=
# PUBLIC_AUTH_URL=http://192.168.1.10:8001
# PUBLIC_RESTAURANT_URL=http://192.168.1.10:8002
# PUBLIC_ORDER_URL=http://192.168.1.10:8003
# PUBLIC_NOTIFICATION_URL=http://192.168.1.10:8004
# PUBLIC_REVIEW_URL=http://192.168.1.10:8005

# Thời gian chờ khi service gọi nhau (giây)
HTTP_TIMEOUT=5
# Chu kỳ worker của Order gửi lại thông báo lỗi (giây, 0 = tắt)
OUTBOX_INTERVAL=15
# Thanh toán trước (VietQR): đơn chưa chuyển khoản sau bao nhiêu phút thì tự hủy; Order quét đơn quá hạn mỗi bao nhiêu giây
PAYMENT_TIMEOUT_MINUTES=15
PAYMENT_SWEEP_SECONDS=60
# INFO hoặc WARNING (WARNING: bớt log truy cập)
LOG_LEVEL=INFO

# Email liên hệ hiện ở trang Điều khoản sử dụng / Chính sách quyền riêng tư.
# BẮT BUỘC đặt trước khi cho người dùng thật dùng thử (họ gửi yêu cầu xóa dữ liệu, khiếu nại tới đây).
CONTACT_EMAIL=

# Sao lưu: python manage.py backup (một lần) / backup --loop, hoặc container "backup" khi chạy Docker
BACKUP_DIR=backups
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24
# pg_dump / pg_restore cho PostgreSQL: để trống thì tìm trong PATH, không có thì chạy bằng Docker image dưới đây
# PG_DUMP=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
# PG_RESTORE=C:/Program Files/PostgreSQL/16/bin/pg_restore.exe
PG_DOCKER_IMAGE=postgres:16

# ---- Chạy bằng Docker: docker compose up -d --build (xem docs/DEPLOY.md)
# Tên miền (hoặc IP LAN) của máy chủ; PUBLIC_ORIGIN = địa chỉ đầy đủ người dùng mở (kèm cổng nếu khác 443)
SERVER_NAME=localhost
PUBLIC_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
# Thư mục trên máy chủ chứa bản sao lưu của container backup
# BACKUP_HOST_DIR=./backups
